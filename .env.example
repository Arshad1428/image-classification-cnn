# Project
PROJECT_NAME=image-classification-cnn

# Data
DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# Models
MODEL_DIR=models

# Outputs
OUTPUT_DIR=outputs

# Image Configuration
IMAGE_SIZE=224
IMAGE_CHANNELS=3

# Training Configuration
BATCH_SIZE=32
EPOCHS=10
LEARNING_RATE=0.001

# Reproducibility
RANDOM_SEED=42

# Hardware
DEVICE=auto

# Model Configuration
MODEL_TYPE=cnn
MODEL_VERSION=v1.0.0
FREEZE_BACKBONE=false

# Experiment Tracking
MLFLOW_TRACKING_URI=mlruns
MLFLOW_EXPERIMENT_NAME=image-classification